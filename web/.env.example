# Zenith Care Solutions — environment variables
#
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# All NEXT_PUBLIC_* variables are shipped to the browser and are safe to expose.
# Server-only secrets (RESEND_*, SMTP_*, …) are NOT shipped to the browser.
# v1 has no backend, so no server-only secrets are required yet.

# ─── Contact ─────────────────────────────────────────────────────────────────

# WhatsApp Business number. Digits only, country code first, no leading '+'.
# Example: 15555551234 (US) or 923001234567 (PK).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Primary email where leads should reach us (used by all `mailto:` links,
# the footer, and the contact page).
NEXT_PUBLIC_CONTACT_EMAIL=ali@zenithcaresolutions.com

# ─── Scheduling ──────────────────────────────────────────────────────────────

# Calendly URL for the 15-min discovery call.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/zenith-care/15min

# ─── Form submission (optional in v1) ────────────────────────────────────────

# Formspree form ID for the contact form (`https://formspree.io/f/<id>`).
# Leave blank until the form is wired up in Phase 2.
NEXT_PUBLIC_FORMSPREE_ID=

# ─── Analytics ───────────────────────────────────────────────────────────────

# Plausible site identifier (your root domain).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=zenithcaresolutions.com

# ─── Site base ───────────────────────────────────────────────────────────────

# Canonical production URL. Used by metadata, OG tags, sitemap, llms.txt.
NEXT_PUBLIC_SITE_URL=https://zenithcaresolutions.com
