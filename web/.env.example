# Zenith Care Solutions — environment variables
# Copy this file to .env.local and fill in. ALL VARS ARE PUBLIC (NEXT_PUBLIC_*).
# There are no server-side secrets in v1 — nothing confidential belongs in this repo.

# Formspree form endpoint id (contact form target)
NEXT_PUBLIC_FORMSPREE_ID=

# Calendly 15-min discovery event URL
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/<handle>/<event>

# WhatsApp Business number, digits only, country code first, no leading '+'
# e.g. 15555555555
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Primary contact email
NEXT_PUBLIC_CONTACT_EMAIL=ali@zenithcaresolutions.com

# Plausible or Umami domain for analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=zenithcaresolutions.com
