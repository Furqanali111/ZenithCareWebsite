# Zenith Care Solutions — environment variables
#
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# All NEXT_PUBLIC_* variables are shipped to the browser and are safe to expose.
# Server-only secrets (RESEND_*, SMTP_*, …) are NOT shipped to the browser.
# v1 has no backend, so no server-only secrets are required yet.

# ─── Contact ─────────────────────────────────────────────────────────────────

# WhatsApp Business number. Digits only, country code first, no leading '+'.
# Example: 15555551234 (US) or 923001234567 (PK).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Primary email where leads should reach us (used by all `mailto:` links,
# the footer, and the contact page).
NEXT_PUBLIC_CONTACT_EMAIL=contact@thezcs.com

# ─── Scheduling ──────────────────────────────────────────────────────────────

# Calendly URL for the 15-min discovery call.
NEXT_PUBLIC_CALENDLY_URL=

# ─── Form submission (optional in v1) ────────────────────────────────────────

# Formspree form ID for the contact form (`https://formspree.io/f/<id>`).
# Leave blank until the form is wired up in Phase 2.
NEXT_PUBLIC_FORMSPREE_ID=

# ─── Analytics ───────────────────────────────────────────────────────────────

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loads only in production builds.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Site base ───────────────────────────────────────────────────────────────

# Canonical production URL. Used by metadata, OG tags, sitemap, llms.txt.
NEXT_PUBLIC_SITE_URL=https://thezcs.com

# ─── Blog editor (Keystatic, /keystatic) ─────────────────────────────────────

# Production only. Leave blank locally: `pnpm dev` edits local files with no login.
# Setup steps: WebSiteDoc/Project/16-keystatic-cms.md
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Any random string of 32+ characters.
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ─── SEO dashboard (/seo-dashboard) ──────────────────────────────────────────

# Password for the SEO team's dashboard (any user name). Set it in Vercel for Production
# and Preview. While unset, the page returns 404 in production and is open in local dev.
SEO_DASHBOARD_PASSWORD=

# Optional: Core Web Vitals from real visitors on the dashboard. A free Google Cloud API key with the
# "Chrome UX Report API" enabled. Without it the dashboard shows how to connect it. A small site may have no data yet.
CRUX_API_KEY=

# Optional: where the editor's Preview button opens a saved branch, for example
# https://zcs-git-{branch}-yourteam.vercel.app  ({branch} becomes the branch name with / turned into -).
# Without it Preview opens the same page on the live site, which does not have an unmerged edit yet.
PREVIEW_URL_TEMPLATE=

# Optional: only if the repo is renamed or forked.
NEXT_PUBLIC_GITHUB_REPO=
